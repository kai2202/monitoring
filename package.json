{
  "name": "printer-monitoring-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Printer Monitoring System — Monorepo (React Frontend + Node.js Backend API + Zabbix Integration)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start -w backend",
    "start:prod": "npm run build:all && npm run start -w backend",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:frontend": "npm run typecheck -w frontend",
    "typecheck:backend": "npm run typecheck -w backend",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend"
  }
}
