{
  "name": "printer-monitoring-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Printer Monitoring System — Monorepo (React Frontend + Node.js Backend API + Zabbix Integration)",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev -w Frontend",
    "dev:mock": "npm run dev:mock -w Frontend",
    "dev:real": "npm run dev:real -w Frontend",
    "dev:backend": "npm run dev -w Backend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build -w Frontend",
    "build:backend": "npm run build -w Backend",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start -w Backend",
    "start:prod": "npm run build:all && npm run start -w Backend",
    "preview": "npm run preview -w Frontend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:frontend": "npm run typecheck -w Frontend",
    "typecheck:backend": "npm run typecheck -w Backend",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test -w Frontend",
    "test:backend": "npm run test -w Backend"
  }
}
