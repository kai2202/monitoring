{
  "name": "printer-monitoring-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Printer Monitoring System — Monorepo (React Frontend + Node.js Backend API + Zabbix Integration)",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev -w Frontend",
    "dev:mock": "npm run dev:mock -w Frontend",
    "dev:real": "npm run dev:real -w Frontend",
    "dev:backend": "npm run dev -w Backend",
    "dev:all": "node scripts/dev-all.js",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build -w Frontend",
    "build:mock": "npm run build:mock -w Frontend",
    "build:pages": "node scripts/build-gh-pages.js",
    "build:backend": "npm run build -w Backend",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start -w Backend",
    "start:prod": "npm run build:all && npm run start -w Backend",
    "preview": "npm run preview -w Frontend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:frontend": "npm run typecheck -w Frontend",
    "typecheck:backend": "npm run typecheck -w Backend",
    "lint:arch": "node scripts/lint-architecture.js",
    "test:zabbix": "npm run test:zabbix -w Backend",
    "db:real-sync": "tsx Backend/scripts/purge-mock-and-sync-real.ts",
    "prisma:push": "npx prisma db push --schema=Backend/prisma/schema.prisma",
    "prisma:seed": "npm run prisma:seed -w Backend",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test -w Frontend",
    "test:backend": "npm run test -w Backend"
  }
}
