# ==============================================================================
# FleetMonitor Backend Environment Configuration (.env.example)
# Khớp 100% với thông số dịch vụ trong database/docker-compose.yml
# ==============================================================================

# 1. Server & CORS
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# 2. PostgreSQL 16 Database (Prisma ORM — database/docker-compose.yml)
DATABASE_URL="postgresql://fleet_admin:fleet_secret_2026@localhost:5432/fleetmonitor?schema=public"

# 3. Authentication & JWT (Zero-Trust Security)
JWT_ACCESS_SECRET="change_this_to_a_strong_32_byte_access_secret_key"
JWT_REFRESH_SECRET="change_this_to_a_strong_32_byte_refresh_secret_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 4. Zabbix 7.0 LTS JSON-RPC API & SNMP Polling
ZABBIX_API_URL="http://localhost:8080/api_jsonrpc.php"
ZABBIX_URL="http://localhost:8080/api_jsonrpc.php"
ZABBIX_API_TOKEN=""
ZABBIX_USER="Admin"
ZABBIX_PASSWORD="zabbix"
ZABBIX_FAST_POLL_MS=30000
ZABBIX_SLOW_POLL_MS=3600000
ZABBIX_SAFE_WINDOW_MS=600000

# 5. MinIO S3 Object Storage (Test Print Proofs & Attachments — database/docker-compose.yml)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="fleet_minio_admin"
MINIO_SECRET_KEY="minio_secret_2026"
MINIO_BUCKET="fleetmonitor-proofs"
MINIO_BUCKET_NAME="fleetmonitor-proofs"
