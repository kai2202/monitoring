# ==============================================================================
# Zabbix 7.0 LTS & PostgreSQL Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_secure_pass_2026
POSTGRES_DB=zabbix

# Zabbix Server Settings
ZBX_SERVER_NAME="Printer-Monitoring-Zabbix"
ZBX_SERVER_PORT=10051
ZBX_STARTPOLLERS=10
ZBX_STARTPOLLERSSNMP=15
ZBX_STARTPINGERS=5
ZBX_STARTTRAPPERS=5
ZBX_STARTDISCOVERERS=3
ZBX_HOUSEKEEPINGFREQUENCY=1
ZBX_MAXHOUSEKEEPERDELETE=5000

# Zabbix Web UI Settings
ZBX_WEB_PORT=8080
PHP_TZ=Asia/Ho_Chi_Minh

# SNMP Defaults
ZBX_DEFAULT_SNMP_COMMUNITY=public
