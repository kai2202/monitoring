# ==============================================================================
# FleetMonitor Frontend — Environment Variables
# ==============================================================================

# Nguồn dữ liệu toàn hệ thống:
# - Đặt VITE_USE_MOCK=false và VITE_DATA_SOURCE=api (Mặc định) để kết nối trực tiếp Backend REST API & PostgreSQL
# - Đặt VITE_USE_MOCK=true và VITE_DATA_SOURCE=mock khi chỉ muốn chạy dữ liệu mô phỏng
VITE_DATA_SOURCE=api
VITE_USE_MOCK=false

# Đường dẫn gốc API (mặc định /api được reverse proxy sang Backend cổng 4000)
VITE_API_BASE_URL=/api
